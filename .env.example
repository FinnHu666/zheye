# Format example only. Spring Boot does not load this file automatically.
# Shared/staging/production credentials must be provisioned outside source control.
FINNS_DB_URL=jdbc:postgresql://127.0.0.1:5432/finns
FINNS_DB_USERNAME=finns_app
FINNS_DB_PASSWORD=replace-with-a-managed-secret
FINNS_DB_POOL_MAX=10
FINNS_DB_POOL_MIN=2
# Personal DeepSeek keys are entered in /me/ai-settings, not in this file.
# Required server-side encryption secret: Base64 of 32 random bytes. Back it up securely.
FINNS_AI_CREDENTIAL_SECRET=replace-with-a-managed-base64-encryption-secret
FINNS_AI_BASE_URL=https://api.deepseek.com
FINNS_AI_MODEL=deepseek-flash
# 0.7.0 角色访问管理：没有任何能管理角色的用户时，启动时把该邮箱对应的已注册账户设为管理员。
FINNS_BOOTSTRAP_ADMIN_EMAIL=owner@example.com
# 操作记录按日期筛选使用的时区（默认 Asia/Shanghai）。
FINNS_AUDIT_ZONE=Asia/Shanghai
